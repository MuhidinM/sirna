{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "The capture box: save and undo a capture (tasks, notes, money, ideas), read, close itself. No db_tx, no secrets.",
  "windows": ["capture"],
  "permissions": [
    "core:event:default",
    "allow-capture-commit",
    "allow-capture-undo",
    "allow-capture-ready",
    "allow-close-window",
    "allow-db-query",
    "allow-capture-replace",
    "allow-open-notes",
    "allow-set-away"
  ]
}
