{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: everything the UI needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-capture-commit",
    "allow-capture-undo",
    "allow-db-query",
    "allow-db-tx",
    "allow-secret-set",
    "allow-secret-status",
    "allow-autostart-set",
    "allow-autostart-status",
    "allow-capture-replace",
    "allow-focus-start",
    "allow-focus-control",
    "allow-focus-status",
    "allow-brief-checks",
    "allow-brief-ready",
    "allow-take-screen"
  ]
}
